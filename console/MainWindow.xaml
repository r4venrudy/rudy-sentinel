<Window x:Class="RudySentinel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RudySentinel"
 Title="Rudy Sentinel / Investigation Console" Width="1440" Height="900" MinWidth="1050" MinHeight="650" Background="#0A1018" Foreground="#EDF4FC" FontFamily="Segoe UI">
 <Grid x:Name="Root" Background="#0A1018" Margin="0">
  <Grid Margin="32">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="R4VENRUDY / ENDPOINT RESEARCH" Foreground="#55E0B6" FontSize="12"/><TextBlock Text="Rudy Sentinel" FontSize="38" FontWeight="Bold" Margin="0,8,0,4"/><TextBlock Text="Follow the behavior. Inspect the evidence." Foreground="#97ACC1" FontSize="16"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Open session" Click="OpenSession"/><Button Content="Export selected case" Click="ExportCase"/></StackPanel>
   </Grid>
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,26,0,20">
    <Border Background="#101B28" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="EVENTS OBSERVED" Foreground="#97ACC1"/><TextBlock x:Name="EventCount" FontSize="32" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Background="#101B28" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="TRACKED PROCESSES" Foreground="#97ACC1"/><TextBlock x:Name="ProcessCount" FontSize="32" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Background="#101B28" Padding="20" Margin="0,0,12,0"><StackPanel><TextBlock Text="BEHAVIORAL ALERTS" Foreground="#97ACC1"/><TextBlock x:Name="AlertCount" FontSize="32" Foreground="#55E0B6" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Background="#101B28" Padding="20"><StackPanel><TextBlock Text="LOST SENSOR EVENTS" Foreground="#97ACC1"/><TextBlock x:Name="LossCount" FontSize="32" Margin="0,8,0,0"/></StackPanel></Border>
   </UniformGrid>
   <DockPanel Grid.Row="2" Margin="0,0,0,18"><TextBlock x:Name="SessionLabel" Foreground="#55E0B6" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ComboBox x:Name="Severity" SelectionChanged="FilterChanged" SelectedIndex="0"><ComboBoxItem Content="All severities"/><ComboBoxItem Content="critical"/><ComboBoxItem Content="high"/><ComboBoxItem Content="medium"/></ComboBox><TextBox x:Name="Search" Width="260" Margin="12,0,0,0" TextChanged="SearchChanged" ToolTip="Search alerts by title, process, rule, or PID"/></StackPanel></DockPanel>
   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <TabControl Background="#101B28" BorderThickness="0" Foreground="#EDF4FC">
     <TabItem Header="Alerts"><DataGrid x:Name="AlertsGrid" SelectionChanged="AlertSelected"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="85"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/><DataGridTextColumn Header="Behavior" Binding="{Binding Title}" Width="*" MinWidth="330"/><DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/><DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="55"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Process tree"><TreeView x:Name="ProcessesTree" Background="#101B28" BorderThickness="0" SelectedItemChanged="ProcessSelected"><TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:ProcessNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}"/></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView></TabItem>
     <TabItem Header="Sensor health"><ScrollViewer><TextBlock x:Name="HealthText" Margin="20" TextWrapping="Wrap" Foreground="#EDF4FC" FontSize="15"/></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Column="2" Background="#101B28" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="INVESTIGATION" Foreground="#55E0B6" FontSize="12"/><TextBlock Text="Evidence &amp; context" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,16"/></StackPanel><TextBox x:Name="Evidence" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Padding="0"/></Grid></Border>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="4" Foreground="#97ACC1" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
